local busy = false

-- Backend integration point:
-- Return a server instance ID with player count <= 2.
-- Backend must be configured by the game developer.
local function getServer()
    return nil
end

local function findServer()
    if busy then return end
    busy = true

    hop.Text = "SEARCHING..."
    status.Text = "Tìm Sever"

    local ok, serverId = pcall(getServer)

    if ok and serverId then
        status.Text = "Đã tìm thấy Sever!"
        hop.Text = "TELEPORTING..."

        local success, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                serverId,
                player
            )
        end)

        if not success then
            warn(err)
            status.Text = "Teleport failed!"
        end
    else
        status.Text = "Đã hết sever"

        task.wait(SEARCH_DELAY)

        status.Text = "Tìm Sever"
        hop.Text = "🔍 FIND SERVER"
    end

    busy = false
end

hop.Activated:Connect(findServer)

-- Drag support: PC + Mobile
local dragging = false
local dragStart
local startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
